# ============================================================
# 环境变量配置示例
# 复制为 .env 并填入真实值（.env 已加入 .gitignore，不会提交）
# ============================================================

# ── 数据库 ───────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DB=aiagent
PG_USER=postgres
PG_PASSWORD=your-strong-password-here

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# ── JWT（生产环境必须修改，至少 32 个随机字符）────────────
JWT_SECRET=your-super-secret-jwt-signing-key-at-least-32-chars
JWT_EXPIRATION=86400

# ── LLM API Keys ─────────────────────────────────────────
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# ── Reranker（可选，本地 BGE 服务）───────────────────────
# RERANKER_URL=http://localhost:8090/rerank

# ── Elasticsearch（可选，BM25 混合检索）──────────────────
ES_ENABLED=false
ES_HOST=localhost
ES_PORT=9200
# ES_USERNAME=
# ES_PASSWORD=

# ── 告警通知（可选）──────────────────────────────────────
ALERT_DINGTALK_ENABLED=false
ALERT_DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxx
ALERT_WECOM_ENABLED=false
ALERT_WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

# ── 限流 ─────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=10
RATE_LIMIT_PER_DAY=500

# ── 应用端口 ─────────────────────────────────────────────
APP_PORT=8080

# ── Spring Profile ───────────────────────────────────────
SPRING_PROFILES_ACTIVE=deepseek

