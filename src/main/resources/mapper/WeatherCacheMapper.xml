<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.aiagent.tool.mapper.WeatherCacheMapper">

    <resultMap id="WeatherCacheResultMap" type="com.example.aiagent.tool.entity.WeatherCache">
        <id     property="id"          column="id"/>
        <result property="city"        column="city"/>
        <result property="weatherDesc" column="weather_desc"/>
        <result property="temperature" column="temperature"/>
        <result property="humidity"    column="humidity"/>
        <result property="wind"        column="wind"/>
        <result property="updatedAt"   column="updated_at"/>
    </resultMap>

    <select id="findByCity" resultMap="WeatherCacheResultMap">
        SELECT *
        FROM biz_weather_cache
        WHERE city = #{city}
    </select>

    <select id="findByCityAndUpdatedAtAfter" resultMap="WeatherCacheResultMap">
        SELECT *
        FROM biz_weather_cache
        WHERE city = #{city}
          AND updated_at &gt;= #{after}
    </select>

    <insert id="insertOrUpdate">
        INSERT INTO biz_weather_cache (city, weather_desc, temperature, humidity, wind, updated_at)
        VALUES (#{city}, #{weatherDesc}, #{temperature}, #{humidity}, #{wind}, NOW())
        ON CONFLICT (city) DO UPDATE SET
            weather_desc = EXCLUDED.weather_desc,
            temperature  = EXCLUDED.temperature,
            humidity     = EXCLUDED.humidity,
            wind         = EXCLUDED.wind,
            updated_at   = NOW()
    </insert>

</mapper>
