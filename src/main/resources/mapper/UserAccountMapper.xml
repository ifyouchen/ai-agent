<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.aiagent.tool.mapper.UserAccountMapper">

    <resultMap id="UserAccountResultMap" type="com.example.aiagent.tool.entity.UserAccount">
        <id     property="id"              column="id"/>
        <result property="userId"          column="user_id"/>
        <result property="username"        column="username"/>
        <result property="balance"         column="balance"/>
        <result property="membershipLevel" column="membership_level"/>
        <result property="points"          column="points"/>
        <result property="createdAt"       column="created_at"/>
        <result property="updatedAt"       column="updated_at"/>
    </resultMap>

    <select id="findByUserId" resultMap="UserAccountResultMap">
        SELECT *
        FROM biz_user_account
        WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO biz_user_account (
            user_id, username, balance, membership_level, points,
            created_at, updated_at
        ) VALUES (
            #{userId}, #{username}, #{balance}, #{membershipLevel}, #{points},
            NOW(), NOW()
        )
    </insert>

</mapper>
