<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.aiagent.security.mapper.OrganizationMapper">

    <resultMap id="orgResultMap" type="com.example.aiagent.security.entity.Organization">
        <id property="id" column="id"/>
        <result property="orgId" column="org_id"/>
        <result property="name" column="name"/>
        <result property="orgType" column="org_type"/>
        <result property="ownerId" column="owner_id"/>
        <result property="description" column="description"/>
        <result property="settings" column="settings"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="selectColumns">
        id, org_id, name, org_type, owner_id, description, settings, status, created_at, updated_at
    </sql>

    <select id="findByOrgId" resultMap="orgResultMap">
        SELECT <include refid="selectColumns"/>
        FROM sys_organization
        WHERE org_id = #{orgId}
    </select>

    <select id="findByOwnerId" resultMap="orgResultMap">
        SELECT <include refid="selectColumns"/>
        FROM sys_organization
        WHERE owner_id = #{ownerId}
        ORDER BY created_at
    </select>

    <select id="findByOrgType" resultMap="orgResultMap">
        SELECT <include refid="selectColumns"/>
        FROM sys_organization
        WHERE org_type = #{orgType}
        ORDER BY created_at
    </select>

    <select id="existsByOrgId" resultType="boolean">
        SELECT COUNT(*) > 0 FROM sys_organization WHERE org_id = #{orgId}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM sys_organization
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_organization (org_id, name, org_type, owner_id, description, settings, status)
        VALUES (#{orgId}, #{name}, #{orgType}, #{ownerId}, #{description}, #{settings}::jsonb, #{status})
    </insert>

    <update id="update">
        UPDATE sys_organization
        SET name = #{name}, description = #{description}, settings = #{settings}::jsonb,
            status = #{status}, updated_at = NOW()
        WHERE org_id = #{orgId}
    </update>

    <delete id="deleteByOrgId">
        DELETE FROM sys_organization WHERE org_id = #{orgId}
    </delete>

</mapper>

